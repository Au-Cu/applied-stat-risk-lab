# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.venv/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/
/tmp/
# Source snapshots may contain names or candidate numbers.  Keep them local;
# only de-identified scores, hashes, and public source URLs may be committed.
/data/private/
# Candidate-roster discovery and OCR intermediates can expose image endpoints,
# local paths, masked names or candidate numbers.  Publish aggregates only.
/data/processed/mini_program_roster_index.csv
/data/processed/mini_program_year_index.csv
/data/processed/roster_asset_manifest.csv
/data/processed/roster_ocr_audit.csv
/data/audit/candidate_score_extraction.json
/data/audit/mini_program_roster_index.json
/data/audit/roster_asset_collection.json
/output/audits/
/output/pdf/v4_render/
/output/pdf/*.pdf
!/output/pdf/报名前信息集下应用统计硕士拟录取初试低位分数的概率预测_V5_逐人分布与来源审计增强.pdf
!/output/pdf/应用统计硕士择校研究_逐字段公共数据来源目录_V5.pdf
